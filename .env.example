; Copy this file to .env in the project root.
; includes/config.php loads it with parse_ini_file() and expects every key below.
; .env is gitignored. These are public endpoints and store links, not secrets.

; Base URL used to build coin page links in includes/api.php.
WHATTOMINE_URL="https://whattomine.com"

; Public JSON feed fetched by fetchMiningData(). No API key.
API_WHATTOMINE_URL="https://whattomine.com/coins.json"

; Loaded at startup. Current code does not call this URL yet.
API_NICEHASH_URL="https://api2.nicehash.com"

; Footer links on the home page and ROI calculator.
AFFILIATE_AMAZON="https://www.amazon.com/"
AFFILIATE_NEWEGG="https://www.newegg.com/"
